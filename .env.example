# --- crawl4ai (required) ---
CRAWL4AI_URL=http://192.168.210.10:11235
# Only if JWT auth is enabled on your crawl4ai server
CRAWL4AI_TOKEN=

# --- Portal access (optional but recommended if exposed via a tunnel) ---
PORTAL_USER=
PORTAL_PASSWORD=

# --- Tuning ---
CRAWL_CONCURRENCY=3        # simultaneous crawl4ai requests
ROW_CONCURRENCY=8          # rows processed in parallel
DNS_CONCURRENCY=40
DNS_SERVERS=               # e.g. 1.1.1.1,8.8.8.8  (blank = container default)
CACHE_TTL_DAYS=30

# --- Optional LLM step (OpenAI-compatible endpoint; leave blank to disable) ---
LLM_PROVIDER=openai        # "openai" = any OpenAI-compatible endpoint, "anthropic" = native Claude API
LLM_BASE_URL=              # openai: e.g. https://openrouter.ai/api/v1 or http://ollama-host:11434/v1 ; anthropic: leave blank
LLM_API_KEY=
LLM_MODEL=                 # e.g. claude-haiku-5-5 (bulk) or claude-sonnet-5-5 (shortlist)
LLM_MAX_CHARS=30000        # crawled text sent per company for partner/customer focus (~7.5k tokens)
LLM_MAX_TOKENS=3000        # max reply size per company
LLM_EXTRA_BODY=            # optional JSON merged into each request, e.g. OpenRouter: {"provider":{"data_collection":"deny"},"reasoning":{"enabled":false}}
